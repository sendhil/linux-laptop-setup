#!/bin/bash

set -o pipefail

if [ "$#" -ne 1 ]; then
  printf 'usage: %s PROFILE\n' "$0" >&2
  exit 2
fi
profile=$1

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
cd "$repo_dir" || exit 2

. "$repo_dir/lib/common.sh"
. "$repo_dir/lib/platform.sh"

# Validate the complete requested configuration before running any operational
# command or service check.
apt_requirements=$(load_apt_requirements "$profile") || exit 2
npm_requirements=$(read_tool_file npm manifests/npm.txt) || exit 2
uv_requirements=$(read_tool_file uv manifests/uv-tools.txt) || exit 2
work_tool_requirements=$(read_tool_file command manifests/work-tools.txt) || exit 2
external_assumptions=$(load_external_assumptions "$profile") || exit 2

policy_agent=${SETUP_POLICY_AGENT:-/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1}
proc_root=${SETUP_PROC_ROOT:-/proc}
if [[ $policy_agent != /* ]]; then
  printf 'error: invalid policy agent path: %s\n' "$policy_agent" >&2
  exit 2
fi
if [[ $policy_agent =~ [[:cntrl:]] ]]; then
  printf 'error: invalid policy agent path\n' >&2
  exit 2
fi
if [[ $proc_root != /* ]]; then
  printf 'error: invalid proc root: %s\n' "$proc_root" >&2
  exit 2
fi
if [[ $proc_root =~ [[:cntrl:]] ]]; then
  printf 'error: invalid proc root\n' >&2
  exit 2
fi

os_release=${SETUP_OS_RELEASE:-/etc/os-release}
load_ubuntu_info "$os_release" || exit 2
detect_arch >/dev/null || exit 2

passes=0
warnings=0
skips=0
failures=0

pass() {
  printf 'PASS %s\n' "$1"
  passes=$((passes + 1))
}

warn() {
  printf 'WARN %s\n' "$1"
  warnings=$((warnings + 1))
}

skip() {
  printf 'SKIP %s\n' "$1"
  skips=$((skips + 1))
}

fail_check() {
  printf 'FAIL %s\n' "$1"
  failures=$((failures + 1))
}

check_command() {
  if command -v "$1" >/dev/null 2>&1; then
    pass "command: $1"
  else
    fail_check "command: $1"
  fi
}

check_fd_command() {
  if command -v fd >/dev/null 2>&1; then
    pass 'command: fd'
  elif command -v fdfind >/dev/null 2>&1; then
    pass 'command: fd (via fdfind)'
  else
    fail_check 'command: fd or fdfind'
  fi
}

check_wezterm_font() {
  font_family='JetBrainsMono Nerd Font Mono'
  if ! command -v fc-match >/dev/null 2>&1; then
    fail_check "font: $font_family (fc-match unavailable)"
    return
  fi
  matched_family=$(fc-match --format '%{family}\n' "$font_family" 2>/dev/null) || {
    fail_check "font: $font_family"
    return
  }
  if printf '%s\n' "$matched_family" | grep -Fq -- "$font_family"; then
    pass "font: $font_family"
  else
    fail_check "font: $font_family"
  fi
}

check_external() {
  if command -v "$1" >/dev/null 2>&1; then
    pass "external command: $1"
  else
    warn "external command: $1"
  fi
}

capture_bounded_command() {
  bounded_output=$("$@" 2>&1 | { head -c 4096; cat >/dev/null; })
  bounded_status=$?
}

report_shell_diagnostic() {
  diagnostic_label=$1
  shift
  capture_bounded_command timeout -k 1 3 "$@"
  diagnostic_status=$bounded_status
  case $diagnostic_status in
    0)
      printf '  shell startup diagnostic: %s (passed)\n' "$diagnostic_label"
      ;;
    124|137)
      printf '  shell startup diagnostic: %s (timed out after 3s; status %s)\n' \
        "$diagnostic_label" "$diagnostic_status"
      ;;
    *)
      printf '  shell startup diagnostic: %s (status %s)\n' \
        "$diagnostic_label" "$diagnostic_status"
      ;;
  esac
}

run_shell_diagnostics() {
  shell_name=$1
  case $shell_name in
    bash)
      report_shell_diagnostic 'bash clean baseline' bash --noprofile --norc -ic exit
      report_shell_diagnostic 'bash .bashrc' bash --noprofile -ic exit
      report_shell_diagnostic 'bash login files' bash --norc -lic exit
      ;;
    zsh)
      report_shell_diagnostic 'zsh clean baseline' zsh -df -ic exit
      report_shell_diagnostic 'zsh user startup' zsh -dlic exit
      ;;
  esac
}

check_shell_startup() {
  shell_name=$1
  capture_bounded_command timeout -k 2 10 "$shell_name" -lic exit
  shell_output=$bounded_output
  shell_status=$bounded_status
  case $shell_status in
    0)
      pass "shell startup: $shell_name"
      ;;
    124|137)
      fail_check "shell startup: $shell_name (timed out after 10s)"
      run_shell_diagnostics "$shell_name"
      ;;
    *)
      fail_check "shell startup: $shell_name (status $shell_status)"
      if [ -n "$shell_output" ]; then
        printf '%s\n' "$shell_output" |
          sed -n '1,20p' |
          sed $'s/\033\\[[0-9;]*[[:alpha:]]//g' |
          LC_ALL=C tr -cd '\11\12\40-\176' |
          sed 's/^/  /'
      fi
      ;;
  esac
}

check_user_service() {
  service_name=$1
  if systemctl --user is-active --quiet "$service_name" >/dev/null 2>&1; then
    pass "user service: $service_name"
  else
    fail_check "user service: $service_name"
  fi
}

check_policy_agent() {
  if [ ! -x "$policy_agent" ]; then
    fail_check "policy agent: not executable: $policy_agent"
    return
  fi
  if [ ! -d "$proc_root" ] || [ ! -r "$proc_root" ]; then
    fail_check "policy agent: cannot verify process state: $proc_root unavailable"
    return
  fi
  canonical_policy_agent=$(readlink -f "$policy_agent" 2>/dev/null) || {
    fail_check "policy agent: cannot verify executable identity: $policy_agent"
    return
  }
  for process_exe in "$proc_root"/[0-9]*/exe; do
    process_id=${process_exe#"$proc_root"/}
    process_id=${process_id%/exe}
    case $process_id in
      ''|*[!0-9]*) continue ;;
    esac
    canonical_process_exe=$(readlink -f "$process_exe" 2>/dev/null) || continue
    if [ "$canonical_process_exe" = "$canonical_policy_agent" ]; then
      pass "policy agent: $policy_agent (running)"
      return
    fi
  done
  fail_check "policy agent: not running: $policy_agent"
}

is_sway_desktop() {
  old_ifs=$IFS
  IFS=:
  read -r -a desktop_parts <<<"${XDG_CURRENT_DESKTOP:-}"
  IFS=$old_ifs
  for desktop_part in "${desktop_parts[@]}"; do
    normalized_part=$(printf '%s' "$desktop_part" |
      sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' |
      LC_ALL=C tr '[:upper:]' '[:lower:]')
    if [ "$normalized_part" = sway ]; then
      return 0
    fi
  done
  return 1
}

# A package is checked only when it is part of the normalized active profile.
# Packages that expose no user-facing executable are covered by the inventory
# commands and, for session components, the service checks below.
while IFS=$'\t' read -r package _required; do
  [ -n "$package" ] || continue
  case $package in
    bat) check_command batcat ;;
    blueman) check_command blueman-applet ;;
    brightnessctl|curl|direnv|fzf|gh|git|git-lfs|grim|jq|kitty|lnav|pipx|pipewire|playerctl|python3|shellcheck|slurp|stow|sway|swayidle|swaylock|tmux|tree|unzip|waybar|wireplumber|wofi|zoxide)
      check_command "$package"
      ;;
    build-essential) check_command make ;;
    fd-find) check_fd_command ;;
    libnotify-bin) check_command notify-send ;;
    mako-notifier) check_command mako ;;
    network-manager-gnome) check_command nm-applet ;;
    neovim) check_command nvim ;;
    ripgrep) check_command rg ;;
    httpie) check_command http ;;
    wl-clipboard)
      check_command wl-copy
      check_command wl-paste
      ;;
    wezterm)
      check_command wezterm
      check_wezterm_font
      ;;
    xwayland) check_command Xwayland ;;
  esac
done <<<"$apt_requirements"

while IFS= read -r command_name; do
  [ -n "$command_name" ] || continue
  check_command "$command_name"
done <<<"$work_tool_requirements"

if [ -n "$npm_requirements" ]; then
  check_command npm
fi
if [ -n "$uv_requirements" ]; then
  check_command uv
  while IFS= read -r tool_name; do
    [ -n "$tool_name" ] || continue
    check_command "$tool_name"
  done <<<"$uv_requirements"
fi

check_shell_startup bash
check_shell_startup zsh

while IFS=$'\t' read -r assumption_type command_name; do
  [ -n "$command_name" ] || continue
  case $assumption_type in
    command) check_external "$command_name" ;;
  esac
done <<<"$external_assumptions"

if is_sway_desktop || [ -n "${SWAYSOCK:-}" ]; then
  sway_session=1
else
  sway_session=0
fi

if [ "$sway_session" -eq 1 ]; then
  check_user_service pipewire.service
  check_user_service wireplumber.service
  check_user_service xdg-desktop-portal.service
  check_user_service xdg-desktop-portal-wlr.service
  check_policy_agent
else
  skip 'Sway session checks: not running under Sway'
fi

proprietary_nvidia=0
if command -v nvidia-smi >/dev/null 2>&1 && \
  timeout -k 2 5 nvidia-smi >/dev/null 2>&1; then
  proprietary_nvidia=1
elif command -v lsmod >/dev/null 2>&1 && \
  lsmod 2>/dev/null | grep -Eq '^nvidia([[:space:]]|_[^[:space:]]+[[:space:]])'; then
  proprietary_nvidia=1
fi
if [ "$proprietary_nvidia" -eq 1 ]; then
  warn 'PROPRIETARY NVIDIA DRIVER DETECTED: Sway does not officially support this driver'
fi

printf 'Summary: PASS %s WARN %s SKIP %s FAIL %s\n' \
  "$passes" "$warnings" "$skips" "$failures"

[ "$failures" -eq 0 ] || exit 1
exit 0
