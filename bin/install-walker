#!/bin/bash
set -u

usage() {
  printf 'usage: %s\n' "$0" >&2
}

configuration_error() {
  printf 'error: %s\n' "$1" >&2
  exit 2
}

install_error() {
  printf 'error: failed to install Walker runtime: %s\n' "$1" >&2
  printf 'rerun: bin/install-walker\n' >&2
  exit 1
}

[ "$#" -eq 0 ] || {
  usage
  exit 2
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
cd "$repo_dir" || exit 2

. "$repo_dir/lib/platform.sh"

os_release=${SETUP_OS_RELEASE:-/etc/os-release}
load_ubuntu_info "$os_release" || exit 2
case $UBUNTU_VERSION_ID in
  22.04|24.04) : ;;
  *) configuration_error "unsupported Ubuntu release for Walker: $UBUNTU_VERSION_ID" ;;
esac
architecture=$(detect_arch) || exit 2
[ "$architecture" = amd64 ] ||   configuration_error "unsupported architecture for Walker: $architecture"
[ "$(id -u)" -ne 0 ] ||   configuration_error 'run this installer as your normal user, not as root'

case ${HOME:-} in
  /*) : ;;
  *) configuration_error 'HOME must be an absolute path' ;;
esac
case $HOME in
  *$'\n'*|*$'\r'*) configuration_error 'HOME contains control characters' ;;
esac

data_home=${XDG_DATA_HOME:-$HOME/.local/share}
case $data_home in
  /*) : ;;
  *) data_home=$HOME/.local/share ;;
esac
case $data_home in
  *$'\n'*|*$'\r'*) configuration_error 'XDG_DATA_HOME contains control characters' ;;
esac

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
case $config_home in
  /*) : ;;
  *) config_home=$HOME/.config ;;
esac
case $config_home in
  *$'\n'*|*$'\r'*) configuration_error 'XDG_CONFIG_HOME contains control characters' ;;
esac

bin_dir=$HOME/.local/bin
managed_root=$data_home/work-laptop-tools/walker
walker_version_dir=$managed_root/walker/v2.17.0
elephant_version_dir=$managed_root/elephant/v2.22.0
providers_dir=$elephant_version_dir/providers
elephant_config_dir=$config_home/elephant
provider_link=$elephant_config_dir/providers

for command_name in bash chmod curl find grep id install ln mkdir mktemp mv readlink rm sha256sum tar; do
  command -v "$command_name" >/dev/null 2>&1 ||     configuration_error "unavailable command: $command_name"
done

walker_archive_name=walker-v2.17.0-x86_64-unknown-linux-gnu.tar.gz
walker_url=https://github.com/abenz1267/walker/releases/download/v2.17.0/$walker_archive_name
walker_sha256=eab433ca0f81b4fd2ab611bb00833c5b33df4c883475c763bb1d7337eb0908fb

elephant_archive_name=elephant-linux-amd64.tar.gz
elephant_url=https://github.com/abenz1267/elephant/releases/download/v2.22.0/$elephant_archive_name
elephant_sha256=4370562d65ae23eb3398e0b80ad429e7049197e17647e8c7526c709b89df8340

provider_names=(desktopapplications providerlist bookmarks clipboard snippets menus)
provider_archive_names=(
  desktopapplications-linux-amd64.tar.gz
  providerlist-linux-amd64.tar.gz
  bookmarks-linux-amd64.tar.gz
  clipboard-linux-amd64.tar.gz
  snippets-linux-amd64.tar.gz
  menus-linux-amd64.tar.gz
)
provider_sha256s=(
  c5e527d2538b60b51297d9fe3cb0ce0867db89dce264464be278a4896658eb54
  82f0de50e4e0e343cee1333e67b1f4ac372f44b94bc24390cd7ace5cce97f500
  49041b19175048c97338be68e1560751ea2ead783a949cba3886f651907bc789
  9af4030af240339b8027143d50f178350c2734c0167062e1ed8aeaf051f3e722
  b506653cc119dd8a6e1be9361bbf249f56827593b5c4b9effe8d4d878eb57c11
  b93795af000ca2269b77b43d1035292087b39fe45c12728c4b299efe6140e9a6
)

for managed_directory in "$managed_root" "$walker_version_dir" "$elephant_version_dir" "$providers_dir" "$elephant_config_dir"; do
  if [ -L "$managed_directory" ]; then
    configuration_error "refusing to use symlinked Walker directory: $managed_directory"
  fi
  if [ -e "$managed_directory" ] && [ ! -d "$managed_directory" ]; then
    configuration_error "refusing to use non-directory Walker path: $managed_directory"
  fi
done

link_matches() {
  target=$1
  expected=$2
  [ -L "$target" ] && [ "$(readlink "$target" 2>/dev/null || true)" = "$expected" ]
}

for command_name in walker elephant; do
  target=$bin_dir/$command_name
  expected=$([ "$command_name" = walker ] && printf '%s' "$walker_version_dir/walker" || printf '%s' "$elephant_version_dir/elephant")
  if [ -e "$target" ] || [ -L "$target" ]; then
    link_matches "$target" "$expected" ||       configuration_error "refusing to overwrite differing user command: $target"
  fi
done

for provider in "${provider_names[@]}"; do
  provider_target=$providers_dir/$provider.so
  if [ -e "$provider_target" ] || [ -L "$provider_target" ]; then
    [ -f "$provider_target" ] && [ ! -L "$provider_target" ] ||       configuration_error "refusing to overwrite differing Walker provider: $provider_target"
  fi
done

if [ -e "$provider_link" ] || [ -L "$provider_link" ]; then
  link_matches "$provider_link" "$providers_dir" ||     configuration_error "refusing to overwrite differing Elephant provider directory: $provider_link"
fi

runtime_ready=1
link_matches "$bin_dir/walker" "$walker_version_dir/walker" || runtime_ready=0
link_matches "$bin_dir/elephant" "$elephant_version_dir/elephant" || runtime_ready=0
link_matches "$provider_link" "$providers_dir" || runtime_ready=0
[ -x "$walker_version_dir/walker" ] || runtime_ready=0
[ -x "$elephant_version_dir/elephant" ] || runtime_ready=0
for provider in "${provider_names[@]}"; do
  [ -f "$providers_dir/$provider.so" ] || runtime_ready=0
done
if [ "$runtime_ready" -eq 1 ]; then
  printf 'Walker and Elephant are already installed.\n'
  exit 0
fi

tmp_dir=$(mktemp -d) || install_error 'temporary staging directory'
cleanup() {
  rm -rf -- "$tmp_dir"
}
trap cleanup EXIT HUP INT TERM

download_asset() {
  label=$1
  archive_name=$2
  url=$3
  sha256=$4
  archive=$tmp_dir/$archive_name
  curl -fL --retry 3 --connect-timeout 10 --max-time 300     -o "$archive" "$url" || install_error "$label archive download"
  [ -s "$archive" ] || install_error "$label archive empty"
  printf '%s  %s\n' "$sha256" "$archive" |
    sha256sum --check --status || install_error "$label archive checksum"
  printf '%s\n' "$archive"
}

validate_archive() {
  label=$1
  archive=$2
  members=$tmp_dir/$label.members
  tar -tzf "$archive" >"$members" || install_error "$label archive listing"
  [ -s "$members" ] || install_error "$label archive is empty"
  while IFS= read -r member; do
    case /$member/ in
      *'/../'*|*'/./'*|//*|*$'\n'*|*$'\r'*) install_error "unsafe $label archive path" ;;
    esac
  done <"$members"
}

extract_archive() {
  label=$1
  archive=$2
  extract_dir=$tmp_dir/$label.extract
  validate_archive "$label" "$archive"
  mkdir -p -- "$extract_dir" || install_error "$label staging directory"
  tar -xzf "$archive" -C "$extract_dir" --no-same-owner --no-same-permissions ||     install_error "$label archive extraction"
  printf '%s\n' "$extract_dir"
}

find_archive_file() {
  label=$1
  extract_dir=$2
  file_name=$3
  matches=()
  while IFS= read -r -d '' match; do
    matches[${#matches[@]}]=$match
  done < <(find "$extract_dir" -type f -name "$file_name" -print0)
  [ "${#matches[@]}" -eq 1 ] || install_error "$label archive missing unique $file_name"
  printf '%s\n' "${matches[0]}"
}

walker_archive=$(download_asset walker "$walker_archive_name" "$walker_url" "$walker_sha256") || exit 1
elephant_archive=$(download_asset elephant "$elephant_archive_name" "$elephant_url" "$elephant_sha256") || exit 1
provider_archives=()
for index in "${!provider_names[@]}"; do
  provider_url=https://github.com/abenz1267/elephant/releases/download/v2.22.0/${provider_archive_names[$index]}
  provider_archives[$index]=$(download_asset "${provider_names[$index]}" "${provider_archive_names[$index]}"     "$provider_url" "${provider_sha256s[$index]}") || exit 1
done

walker_extract=$(extract_archive walker "$walker_archive") || exit 1
elephant_extract=$(extract_archive elephant "$elephant_archive") || exit 1
walker_binary=$(find_archive_file walker "$walker_extract" walker) || exit 1
elephant_binary=$(find_archive_file elephant "$elephant_extract" elephant) || exit 1

provider_extracts=()
provider_files=()
for index in "${!provider_names[@]}"; do
  provider_extracts[$index]=$(extract_archive "${provider_names[$index]}" "${provider_archives[$index]}") || exit 1
  provider_files[$index]=$(find_archive_file "${provider_names[$index]}" "${provider_extracts[$index]}" "${provider_names[$index]}.so") || exit 1
done

mkdir -p -- "$bin_dir" "$walker_version_dir" "$elephant_version_dir" "$providers_dir"   "$elephant_config_dir" || install_error 'Walker directories'
install -m 0755 -- "$walker_binary" "$walker_version_dir/walker" || install_error 'Walker binary'
install -m 0755 -- "$elephant_binary" "$elephant_version_dir/elephant" || install_error 'Elephant binary'
for index in "${!provider_names[@]}"; do
  install -m 0755 -- "${provider_files[$index]}"     "$providers_dir/${provider_names[$index]}.so" ||     install_error "${provider_names[$index]} provider"
done

link_command() {
  source_path=$1
  target_path=$2
  if [ -L "$target_path" ]; then
    link_matches "$target_path" "$source_path" ||       install_error "differing link: $target_path"
    return 0
  fi
  [ ! -e "$target_path" ] || install_error "refusing to overwrite differing path: $target_path"
  link_temp=$target_path.setup.$$
  ln -s -- "$source_path" "$link_temp" || install_error "link $target_path"
  mv -f -- "$link_temp" "$target_path" || install_error "activate $target_path"
}

link_command "$walker_version_dir/walker" "$bin_dir/walker"
link_command "$elephant_version_dir/elephant" "$bin_dir/elephant"
link_command "$providers_dir" "$provider_link"

printf 'Walker and Elephant are installed.\n'
