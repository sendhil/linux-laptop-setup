#!/bin/bash

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
cd "$repo_dir" || exit 2

. "$repo_dir/lib/common.sh"
. "$repo_dir/lib/platform.sh"
. "$repo_dir/lib/inventory.sh"

if [ "$#" -ne 1 ]; then
  printf 'usage: %s PROFILE\n' "$0" >&2
  exit 2
fi
profile=$1

inventory_contains() {
  inventory=$1
  desired=$2
  while IFS= read -r installed; do
    [ "$installed" = "$desired" ] && return 0
  done <<<"$inventory"
  return 1
}

configuration_error() {
  printf 'error: %s\n' "$1" >&2
  exit 2
}

install_error() {
  printf 'error: failed to install %s: %s\n' "$1" "$2" >&2
  printf 'rerun: bin/apply %s\n' "$profile" >&2
  exit 1
}

# Load and normalize every manifest before querying or mutating a manager.
apt_requirements=$(load_apt_requirements "$profile") || exit 2
npm_requirements=$(read_tool_file npm manifests/npm.txt) || exit 2
uv_requirements=$(read_tool_file uv manifests/uv-tools.txt) || exit 2
os_release=${SETUP_OS_RELEASE:-/etc/os-release}
load_ubuntu_info "$os_release" || exit 2
detect_arch >/dev/null || exit 2

for command_name in dpkg-query apt-cache dpkg; do
  command -v "$command_name" >/dev/null 2>&1 || \
    configuration_error "APT: unavailable command $command_name"
done

apt_missing=''
npm_missing=''
uv_missing=''

# Build the complete APT plan and validate every missing package candidate.
while IFS=$'\t' read -r package required; do
  [ -n "$package" ] || continue
  installed=$(apt_installed_version "$package")
  inventory_status=$?
  [ "$inventory_status" -eq 0 ] || configuration_error "APT inventory failed for $package"

  if [ -n "$installed" ]; then
    if [ -n "$required" ]; then
      dpkg --compare-versions "$installed" ge "$required"
      comparison=$?
      case $comparison in
        0) : ;;
        1)
          configuration_error "APT $package is installed at $installed but requires $required; apply installs only missing packages"
          ;;
        *) configuration_error "APT version comparison failed for $package installed $installed" ;;
      esac
    fi
    continue
  fi

  candidate=$(apt_candidate_version "$package")
  candidate_status=$?
  [ "$candidate_status" -eq 0 ] || configuration_error "APT candidate inventory failed for $package"
  [ -n "$candidate" ] || configuration_error "APT $package has no install candidate"
  if [ -n "$required" ]; then
    dpkg --compare-versions "$candidate" ge "$required"
    comparison=$?
    case $comparison in
      0) : ;;
      1) configuration_error "APT $package candidate $candidate is below required $required" ;;
      *) configuration_error "APT version comparison failed for $package candidate $candidate" ;;
    esac
  fi
  apt_missing=$(append_line "$apt_missing" "$package")
done <<<"$apt_requirements"

if [ -n "$npm_requirements" ]; then
  command -v npm >/dev/null 2>&1 || \
    configuration_error 'npm: unavailable (required by non-empty manifest)'
  npm_installed=$(npm_inventory)
  inventory_status=$?
  [ "$inventory_status" -eq 0 ] || configuration_error 'npm inventory failed'
  while IFS= read -r package; do
    [ -n "$package" ] || continue
    inventory_contains "$npm_installed" "$package" || \
      npm_missing=$(append_line "$npm_missing" "$package")
  done <<<"$npm_requirements"
fi

if [ -n "$uv_requirements" ]; then
  command -v uv >/dev/null 2>&1 || \
    configuration_error 'uv: unavailable (required by non-empty manifest)'
  uv_installed=$(uv_inventory)
  inventory_status=$?
  [ "$inventory_status" -eq 0 ] || configuration_error 'uv inventory failed'
  while IFS= read -r package; do
    [ -n "$package" ] || continue
    inventory_contains "$uv_installed" "$package" || \
      uv_missing=$(append_line "$uv_missing" "$package")
  done <<<"$uv_requirements"
fi

if [ -n "$apt_missing" ]; then
  command -v apt-get >/dev/null 2>&1 || configuration_error 'APT: unavailable command apt-get'
  sudo_command=${SETUP_SUDO_COMMAND:-sudo}
  validate_tool_id command "$sudo_command" || configuration_error "invalid privilege command: $sudo_command"
  command -v "$sudo_command" >/dev/null 2>&1 || \
    configuration_error 'sudo is required to install missing APT packages'
fi

# Nothing above this line may mutate package-manager state.
if [ -n "$apt_missing" ]; then
  "$sudo_command" apt-get update || install_error 'APT metadata' 'apt-get update'
  while IFS= read -r package; do
    [ -n "$package" ] || continue
    "$sudo_command" apt-get install -y --no-install-recommends -- "$package" || \
      install_error 'APT package' "$package"
  done <<<"$apt_missing"
fi

while IFS= read -r package; do
  [ -n "$package" ] || continue
  npm_config_update_notifier=false npm_config_audit=false \
    npm install --global "$package" || install_error 'npm tool' "$package"
done <<<"$npm_missing"

while IFS= read -r package; do
  [ -n "$package" ] || continue
  UV_NO_PROGRESS=1 uv tool install "$package" || install_error 'uv tool' "$package"
done <<<"$uv_missing"

printf 'apply complete for profile: %s\n' "$profile"
